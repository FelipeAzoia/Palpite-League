{
  "name": "palpite-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix src/frontend run dev",
    "dev:server": "npm --prefix src/backend run dev",
    "build": "npm --prefix src/frontend run build",
    "preview": "npm --prefix src/frontend run preview",
    "start": "npm --prefix src/backend start",
    "test:backend": "npm --prefix src/backend test",
    "test:frontend": "npm --prefix src/frontend test",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}