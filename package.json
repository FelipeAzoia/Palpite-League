{
  "name": "palpite-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix src/frontend run dev",
    "dev:server": "npm --prefix src/backend run dev",
    "build": "npm --prefix src/frontend run build",
    "preview": "npm --prefix src/frontend run preview",
    "start": "npm --prefix src/backend start",
    "test:backend": "npm --prefix src/backend test",
    "test:frontend": "npm --prefix src/frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "11.10.0",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "vitest": "^4.1.12"
  }
}
