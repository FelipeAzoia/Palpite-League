{
  "name": "palpite-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "dev:server": "node --env-file-if-exists=.env --watch backend/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env backend/index.js",
    "test:backend": "node --test tests/foundation.test.js",
    "test:frontend": "vitest run tests/health.frontend.test.js",
    "test:integration": "node --test tests/foundation.integration.test.js",
    "test": "npm run test:backend && npm run test:frontend && npm run test:integration"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
